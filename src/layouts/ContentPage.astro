---
import BaseLayout from './BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import NextStep from '@/components/NextStep.astro';
import { findNav, nextInSection } from '@/data/nav';
import { stripBase } from '@/lib/url';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  lead?: string;
  description?: string;
  /** Override the automatically derived breadcrumbs. */
  crumbs?: { label: string; href?: string }[];
  nextStep?: 'learn' | 'join' | 'none';
  headerImage?: ImageMetadata;
}
const { title, lead, description, nextStep = 'learn', headerImage } = Astro.props;

const path = stripBase(Astro.url.pathname);
const { section } = findNav(path);
const crumbs =
  Astro.props.crumbs ??
  (section
    ? [{ label: section.label, href: section.href }, { label: title }]
    : [{ label: title }]);
const next = nextInSection(path);
---

<BaseLayout title={title} description={description ?? lead}>
  <PageHeader title={title} lead={lead} crumbs={crumbs} photo={headerImage} />
  <div class="section section--tight">
    <div class="container">
      <slot />
    </div>
  </div>
  <slot name="after" />
  {
    nextStep !== 'none' && (
      <NextStep
        variant={nextStep === 'join' ? 'article' : 'learn'}
        next={next && { href: next.href, label: next.label, description: next.description }}
      />
    )
  }
</BaseLayout>
