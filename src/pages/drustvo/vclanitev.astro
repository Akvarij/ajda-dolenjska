---
import ContentPage from '@/layouts/ContentPage.astro';
import Icon from '@/components/Icon.astro';
import MembershipForm from '@/components/MembershipForm.astro';

const benefits = [
  { icon: 'jar', title: 'Navodila za preparate', text: 'Praktična pomoč pri pripravi in uporabi biodinamičnih preparatov.' },
  { icon: 'graduation', title: 'Izobraževanja', text: 'Predavanja, delavnice in osnovni tečaj z izkušenimi biodinamiki.' },
  { icon: 'calendar', title: 'Setveni koledar', text: 'Možnost nakupa Setvenega koledarja, da veste, kdaj sejati, presajati, negovati in pobirati.' },
  { icon: 'users', title: 'Skupnost', text: 'Srečanja, izleti in obiski kmetij v družbi ljudi, ki delijo isto pot.' },
] as const;
---

<ContentPage
  title="Kako postati član Društva Ajda Dolenjska?"
  lead="Vabljeni v Društvo Ajda Dolenjska!"
  nextStep="none"
>
  <div class="join-layout">
    <div class="prose">
      <p>
        Vas zanima pridelava zdrave hrane, ohranjanje rodovitnosti zemlje in življenje v sožitju z naravo? Želite
        spoznati biodinamične metode pridelovanja, pridobiti nova znanja in jih izmenjevati z drugimi? Vabljeni, da se
        nam pridružite!
      </p>
      <p>Član društva postanete z izpolnitvijo pristopnega obrazca.</p>
      <h2>Kaj dobite kot član</h2>
      <ul class="benefits">
        {
          benefits.map((b) => (
            <li>
              <span class="ic"><Icon name={b.icon} size={28} /></span>
              <div>
                <h3>{b.title}</h3>
                <p>{b.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
      <p>
        Članstvo vam omogoča sodelovanje na delavnicah, na katerih se učimo pripravljati in uporabljati biodinamične
        preparate. Člani, ki sodelujejo pri izdelavi preparatov, jih lahko brezplačno prejmejo za uporabo na svojih
        vrtovih in kmetijah. Preparatov imamo dovolj. Naša želja je, da jih čim več uporabljamo.
      </p>
      <p>
        Delovanje društva temelji na sodelovanju, izmenjavi znanja in prostovoljnem delu. Zato vas vabimo, da se
        udeležite delavnic in s svojim prispevkom pomagate pri pripravi biodinamičnih preparatov ter drugih dejavnostih
        društva.
      </p>
      <p>
        Poleg pridobivanja znanja so pomembni tudi druženje, medsebojna pomoč in izmenjava izkušenj. Skupaj se srečujemo
        na piknikih, ekskurzijah in občnih zborih, kjer krepimo naše vezi ter iščemo nove ideje in rešitve za sonaravno
        pridelavo hrane.
      </p>
      <h2>Članarina</h2>
      <p>
        Letno članarino potrdijo člani društva na občnem zboru. Članarina za leti 2026 in 2027 znaša 20,00&nbsp;€. Vsak član
        društva ima v društvu možnost kupiti Setveni koledar.
      </p>
      {/* ŠE MANJKA: transakcijski račun za vplačilo članarine; pristopnica v PDF za tisk, ki se odda osebno, po pošti ali skenirana na joze.jojo@gmail.com. */}
    </div>

    <div class="panel form-panel">
      <h2>Pristopnica v Društvo Ajda Dolenjska</h2>
      <p>Izpolnite spodnji obrazec in oddajte elektronsko pristopnico.</p>
      <MembershipForm />
    </div>
  </div>
</ContentPage>

<style>
  .join-layout {
    display: grid;
    gap: 2.5rem 3.5rem;
    align-items: start;
  }
  @media (min-width: 960px) {
    .join-layout {
      grid-template-columns: 1fr 1fr;
    }
  }
  .benefits {
    display: grid;
    gap: 1.25rem;
    margin: 0 0 2rem;
    padding: 0;
    list-style: none;
  }
  .benefits li {
    display: flex;
    gap: 1.1rem;
    align-items: flex-start;
    margin: 0;
  }
  .benefits li::marker {
    content: none;
  }
  .ic {
    flex: none;
    display: grid;
    place-items: center;
    width: 3.75rem;
    height: 3.75rem;
    border-radius: 18px;
    background: var(--c-lime);
    color: var(--c-green-deep);
  }
  .benefits h3 {
    margin: 0 0 0.15rem;
  }
  .benefits p {
    margin: 0;
    color: var(--c-ink-soft);
  }
</style>
