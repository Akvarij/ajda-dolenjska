---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import blossoms from '@/assets/photos/cvetoca-ajda.jpg';
import { joinHref } from '@/data/nav';
import { url } from '@/lib/url';

interface Props {
  /** Yellow tint around the photo card; `none` leaves the page background. */
  band?: 'none' | 'yellow';
  heading?: string;
  text?: string;
}
const {
  band = 'none',
  heading = 'Postanite del naše skupnosti',
  text = 'Člani se na delavnicah učimo pripravljati in uporabljati biodinamične preparate ter se srečujemo na piknikih, ekskurzijah in občnih zborih. Pridružite se ljudem, ki jim ni vseeno, kakšno hrano jemo in kakšno zemljo zapuščamo.',
} = Astro.props;
---

<section class:list={['join', band !== 'none' && `band--${band}`]} data-join aria-labelledby="join-title">
  <div class="container">
    <div class="join__card">
      <Image
        class="join__photo"
        src={blossoms}
        alt=""
        widths={[640, 1000, 1400, 1900]}
        sizes="(min-width: 1300px) 1240px, 100vw"
      />
      <div class="join__text">
        <span class="join__eyebrow">Včlanitev</span>
        <h2 id="join-title">{heading}</h2>
        <p>{text}</p>
        <div class="btn-row">
          <a class="btn btn--join" href={url(joinHref)}>
            Postani član <Icon name="arrow-right" size={18} />
          </a>
          <a class="btn btn--ghost" href={url('/drustvo/o-drustvu/')}>Več o društvu</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .join {
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
  }
  .join__card {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    align-items: center;
    min-height: 22rem;
    padding: clamp(2rem, 6vw, 4.5rem);
    border-radius: clamp(1.75rem, 4vw, 3rem);
    background: var(--c-coral-tint);
    box-shadow: 0 30px 60px -30px rgb(32 51 28 / 0.45);
  }
  .join__card :global(.join__photo) {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .join__card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    /* a light coral wash on the text side keeps ink text readable, the photo shows on the right */
    background: linear-gradient(
      100deg,
      color-mix(in srgb, var(--c-coral-tint) 97%, transparent) 0%,
      color-mix(in srgb, var(--c-coral-tint) 90%, transparent) 45%,
      color-mix(in srgb, var(--c-coral-tint) 15%, transparent) 100%
    );
  }
  @media (max-width: 700px) {
    .join__card::before {
      background: color-mix(in srgb, var(--c-coral-tint) 90%, transparent);
    }
  }
  .join__text {
    max-width: 40rem;
    color: var(--c-ink);
  }
  .join__eyebrow {
    display: inline-block;
    margin-bottom: 0.9rem;
    color: var(--c-ink);
    font-size: var(--fs-min);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .join__text p {
    margin-bottom: 1.75rem;
    color: var(--c-ink);
    font-size: 1.05rem;
  }
</style>
