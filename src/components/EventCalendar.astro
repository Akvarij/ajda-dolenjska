---
import Icon from './Icon.astro';
import { dateKey } from '@/lib/format';
import { eventUrl, typeLabels, endKey, type EventEntry } from '@/lib/events';

interface Props {
  events: EventEntry[];
}
const { events } = Astro.props;

const data = events.map((e) => ({
  title: e.data.title,
  url: eventUrl(e),
  start: dateKey(e.data.date),
  end: endKey(e),
  type: e.data.type,
  typeLabel: typeLabels[e.data.type],
  time: e.data.time ?? '',
  registration: e.data.registration.required,
}));
---

<section class="calendar" data-calendar hidden aria-label="Koledar dogodkov">
  <script type="application/json" data-events set:html={JSON.stringify(data)} />
  <div class="cal__head">
    <button type="button" class="icon-btn" data-prev aria-label="Prejšnji mesec">
      <Icon name="chevron-down" size={26} class="rot-l" />
    </button>
    <h2 data-title aria-live="polite"></h2>
    <button type="button" class="icon-btn" data-next aria-label="Naslednji mesec">
      <Icon name="chevron-down" size={26} class="rot-r" />
    </button>
    <button type="button" class="btn btn--ghost btn--sm" data-today>Danes</button>
  </div>
  <table class="cal__grid">
    <caption class="sr-only">Mesečni koledar dogodkov</caption>
    <thead data-head></thead>
    <tbody data-body></tbody>
  </table>
  <p class="cal__legend">
    <span><i class="dot dot--izobrazevanje"></i> Izobraževanje in delavnica</span>
    <span><i class="dot dot--izlet"></i> Izlet in srečanje</span>
    <span><i class="dot dot--dogodek"></i> Drugi dogodek</span>
  </p>
</section>

<script>
  interface CalEvent {
    title: string;
    url: string;
    start: string;
    end: string;
    type: string;
    typeLabel: string;
    time: string;
    registration: boolean;
  }

  const root = document.querySelector<HTMLElement>('[data-calendar]');
  if (root) {
    const events: CalEvent[] = JSON.parse(root.querySelector('[data-events]')!.textContent ?? '[]');
    const title = root.querySelector<HTMLElement>('[data-title]')!;
    const head = root.querySelector<HTMLElement>('[data-head]')!;
    const body = root.querySelector<HTMLElement>('[data-body]')!;
    const locale = 'sl-SI';
    const pad = (n: number) => String(n).padStart(2, '0');
    const key = (y: number, m: number, d: number) => `${y}-${pad(m + 1)}-${pad(d)}`;
    const group = (t: string) =>
      t === 'izobrazevanje' || t === 'delavnica' ? 'izobrazevanje' : t === 'izlet' || t === 'srecanje' ? 'izlet' : 'dogodek';

    const now = new Date();
    const todayKey = key(now.getFullYear(), now.getMonth(), now.getDate());
    let year = now.getFullYear();
    let month = now.getMonth();

    // Monday-first weekday header, localised.
    const monday = new Date(2024, 0, 1);
    head.innerHTML =
      '<tr>' +
      Array.from({ length: 7 }, (_, i) => {
        const d = new Date(monday);
        d.setDate(monday.getDate() + i);
        return `<th scope="col"><abbr title="${d.toLocaleDateString(locale, { weekday: 'long' })}">${d.toLocaleDateString(locale, { weekday: 'short' })}</abbr></th>`;
      }).join('') +
      '</tr>';

    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

    function render() {
      const first = new Date(year, month, 1);
      title.textContent = first.toLocaleDateString(locale, { month: 'long', year: 'numeric' });
      const offset = (first.getDay() + 6) % 7;
      const days = new Date(year, month + 1, 0).getDate();
      const cells = Math.ceil((offset + days) / 7) * 7;
      let html = '';
      for (let i = 0; i < cells; i++) {
        if (i % 7 === 0) html += '<tr>';
        const dayNum = i - offset + 1;
        if (dayNum < 1 || dayNum > days) {
          html += '<td class="out"></td>';
        } else {
          const k = key(year, month, dayNum);
          const todays = events.filter((e) => e.start <= k && k <= e.end);
          const list = todays
            .map(
              (e) =>
                `<li><a class="ev ev--${group(e.type)}" href="${e.url}" title="${esc(e.typeLabel)}${e.registration ? ', prijava obvezna' : ''}">${e.time ? `<b>${esc(e.time)}</b> ` : ''}${esc(e.title)}</a></li>`,
            )
            .join('');
          html += `<td class="${k === todayKey ? 'today' : ''}${todays.length ? ' has' : ''}"><span class="n">${dayNum}</span>${list ? `<ul>${list}</ul>` : ''}</td>`;
        }
        if (i % 7 === 6) html += '</tr>';
      }
      body.innerHTML = html;
    }

    const shift = (n: number) => {
      const d = new Date(year, month + n, 1);
      year = d.getFullYear();
      month = d.getMonth();
      render();
    };
    root.querySelector('[data-prev]')!.addEventListener('click', () => shift(-1));
    root.querySelector('[data-next]')!.addEventListener('click', () => shift(1));
    root.querySelector('[data-today]')!.addEventListener('click', () => {
      year = now.getFullYear();
      month = now.getMonth();
      render();
    });

    // Open on the month of the next event if the current month is empty.
    const upcoming = events.find((e) => e.end >= todayKey);
    if (upcoming && !events.some((e) => e.start.startsWith(key(year, month, 1).slice(0, 7)))) {
      year = Number(upcoming.start.slice(0, 4));
      month = Number(upcoming.start.slice(5, 7)) - 1;
    }
    render();
    root.hidden = false;
  }
</script>

<style>
  .calendar {
    display: none;
    background: #fff;
    border: 1px solid var(--c-line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    padding: clamp(1rem, 2.5vw, 1.75rem);
  }
  @media (min-width: 760px) {
    .calendar:not([hidden]) {
      display: block;
    }
  }
  .cal__head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }
  .cal__head h2 {
    flex: 1;
    margin: 0;
    text-align: center;
    text-transform: capitalize;
  }
  .icon-btn {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 0;
    border-radius: 50%;
    background: var(--c-tint);
    color: var(--c-green-deep);
    cursor: pointer;
  }
  .icon-btn:hover {
    background: var(--c-tint-strong);
  }
  .calendar :global(.rot-l) {
    transform: rotate(90deg);
  }
  .calendar :global(.rot-r) {
    transform: rotate(-90deg);
  }
  .cal__grid {
    width: 100%;
    table-layout: fixed;
    border-collapse: separate;
    border-spacing: 0.35rem;
  }
  .cal__grid :global(th) {
    padding: 0.4rem 0;
    font-size: 1rem;
    font-weight: 800;
    text-transform: capitalize;
    color: var(--c-green-deep);
  }
  .cal__grid :global(abbr) {
    text-decoration: none;
  }
  .cal__grid :global(td) {
    height: 7.25rem;
    padding: 0.4rem 0.5rem;
    vertical-align: top;
    background: #fafcf3;
    border-radius: 14px;
  }
  .cal__grid :global(td.out) {
    background: transparent;
  }
  .cal__grid :global(td.today) {
    background: var(--c-sun-tint);
    box-shadow: inset 0 0 0 2px var(--c-sun);
  }
  .cal__grid :global(.n) {
    display: block;
    margin-bottom: 0.2rem;
    font-weight: 800;
    font-size: 1rem;
  }
  .cal__grid :global(ul) {
    display: grid;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .cal__grid :global(.ev) {
    display: block;
    padding: 0.2rem 0.5rem;
    border-radius: 8px;
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.3;
    text-decoration: none;
    color: #fff;
    background: var(--c-green);
    overflow: hidden;
  }
  .cal__grid :global(.ev--izlet) {
    background: #b4546a;
  }
  .cal__grid :global(.ev--dogodek) {
    background: #8a6a2a;
  }
  .cal__grid :global(.ev:hover) {
    filter: brightness(0.9);
    color: #fff;
  }
  .cal__legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin: 1rem 0 0;
    font-size: 1rem;
    color: var(--c-ink-soft);
  }
  .dot {
    display: inline-block;
    width: 0.8rem;
    height: 0.8rem;
    margin-right: 0.35rem;
    border-radius: 50%;
    background: var(--c-green);
  }
  .dot--izlet {
    background: #b4546a;
  }
  .dot--dogodek {
    background: #8a6a2a;
  }
</style>
