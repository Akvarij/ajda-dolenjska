---
/** Decorative sprig of buckwheat (ajda): heart-shaped leaves, pink-white blossom clusters. */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;

const leaf = 'M0 0C-20-6-30-30-6-46 0-40 6-40 12-46 34-30 20-6 0 0z';
const blooms = [
  [150, 52], [172, 44], [194, 58], [128, 62], [160, 72], [184, 80], [140, 88], [208, 82],
  [120, 108], [152, 104], [176, 112], [200, 106], [222, 118], [132, 128], [162, 134], [190, 138],
  [110, 150], [214, 148], [146, 158], [178, 162],
];
---

<svg
  class={className}
  viewBox="0 0 300 420"
  fill="none"
  role="presentation"
  aria-hidden="true"
  focusable="false"
>
  <path d="M150 410 C146 330 160 250 152 170 C148 130 160 100 176 60" stroke="#7fa13c" stroke-width="5" stroke-linecap="round" />
  <path d="M154 190 C130 150 118 120 124 98" stroke="#8fb04a" stroke-width="3.5" stroke-linecap="round" />
  <path d="M158 170 C190 140 214 124 226 110" stroke="#8fb04a" stroke-width="3.5" stroke-linecap="round" />
  <g fill="#a9cc4a">
    <path d={leaf} transform="translate(150 340) rotate(-62) scale(1.5)" />
    <path d={leaf} transform="translate(152 300) rotate(64) scale(1.4)" fill="#c2dc72" />
    <path d={leaf} transform="translate(151 250) rotate(-58) scale(1.2)" fill="#c2dc72" />
    <path d={leaf} transform="translate(153 212) rotate(60) scale(1.05)" />
  </g>
  {
    blooms.map(([x, y], i) => (
      <g>
        <circle cx={x} cy={y} r={8 + (i % 3)} fill={i % 4 === 0 ? '#f7c3c8' : '#fff'} stroke="#f2a5ad" stroke-width="1.5" />
        <circle cx={x} cy={y} r="2.5" fill="#f6c04a" />
      </g>
    ))
  }
</svg>
