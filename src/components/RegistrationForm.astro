---
import { site } from '@/config/site';
import FormTail from './FormTail.astro';

interface Props {
  eventTitle: string;
  eventWhen: string;
}
const { eventTitle, eventWhen } = Astro.props;
const id = 'prijava';
---

<form
  class="form"
  method="post"
  action={site.forms.endpoint || undefined}
  data-form="prijava"
  data-endpoint={site.forms.endpoint || undefined}
  data-mailto={site.forms.fallbackEmail}
  data-subject={`Prijava: ${eventTitle}`}
  data-success="Hvala! Vašo prijavo smo prejeli. Za morebitna vprašanja se bomo oglasili."
>
  <input type="hidden" name="_subject" value={`Prijava: ${eventTitle}`} />
  <input type="hidden" name="dogodek" value={eventTitle} />
  <input type="hidden" name="termin" value={eventWhen} />
  <div class="form__row">
    <div class="field">
      <label for={`${id}-ime`}>Ime in priimek <span class="req">*</span></label>
      <input type="text" id={`${id}-ime`} name="ime" autocomplete="name" required />
    </div>
    <div class="field">
      <label for={`${id}-email`}>E-naslov <span class="req">*</span></label>
      <input type="email" id={`${id}-email`} name="email" autocomplete="email" required />
    </div>
  </div>
  <div class="form__row">
    <div class="field">
      <label for={`${id}-telefon`}>Telefon</label>
      <input type="tel" id={`${id}-telefon`} name="telefon" autocomplete="tel" />
    </div>
    <div class="field">
      <label for={`${id}-oseb`}>Število oseb</label>
      <input type="number" id={`${id}-oseb`} name="stevilo_oseb" min="1" max="20" value="1" />
    </div>
  </div>
  <div class="field">
    <label for={`${id}-opomba`}>Opomba</label>
    <textarea id={`${id}-opomba`} name="opomba"></textarea>
    <p class="hint">Na primer prehranske omejitve ali vprašanja organizatorju.</p>
  </div>
  <FormTail
    id={id}
    submitLabel="Prijavi se"
    consent="Soglašam, da društvo moje podatke uporabi za organizacijo tega dogodka."
  />
</form>
