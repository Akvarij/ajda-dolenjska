---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { libraryPhotoFor } from '@/lib/photos';

interface Props {
  image?: ImageMetadata;
  alt?: string;
  /** Picks the library photo when there is no photo of its own. */
  seed?: number | string;
  ratio?: string;
  sizes?: string;
  class?: string;
  loading?: 'lazy' | 'eager';
}
const {
  image,
  alt = '',
  seed = 1,
  ratio = '16 / 10',
  sizes = '(min-width: 900px) 33vw, 100vw',
  class: className,
  loading = 'lazy',
} = Astro.props;
---

<div class:list={['pic', className]} style={`aspect-ratio: ${ratio}`}>
  {
    image ? (
      <Image src={image} alt={alt} widths={[480, 800, 1200]} sizes={sizes} loading={loading} />
    ) : (
      <Image src={libraryPhotoFor(seed)} alt="" widths={[480, 800, 1200]} sizes={sizes} loading={loading} />
    )
  }
</div>

<style>
  .pic {
    overflow: hidden;
    background: var(--c-green-tint);
  }
  .pic :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
