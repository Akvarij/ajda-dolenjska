---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Placeholder from './Placeholder.astro';

interface Props {
  image?: ImageMetadata;
  alt?: string;
  /** Picks the illustration variant when there is no photo. */
  seed?: number | string;
  ratio?: string;
  sizes?: string;
  class?: string;
  loading?: 'lazy' | 'eager';
}
const {
  image,
  alt = '',
  seed = 1,
  ratio = '16 / 10',
  sizes = '(min-width: 900px) 33vw, 100vw',
  class: className,
  loading = 'lazy',
} = Astro.props;
---

<div class:list={['pic', className]} style={`aspect-ratio: ${ratio}`}>
  {
    image ? (
      <Image src={image} alt={alt} widths={[480, 800, 1200]} sizes={sizes} loading={loading} />
    ) : (
      <Placeholder seed={seed} />
    )
  }
</div>

<style>
  .pic {
    overflow: hidden;
    background: var(--c-tint);
  }
  .pic :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
