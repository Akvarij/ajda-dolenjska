---
import { site } from '@/config/site';
import FormTail from './FormTail.astro';
import { url } from '@/lib/url';

const id = 'clan';
---

<form
  class="form"
  method="post"
  action={site.forms.endpoint || undefined}
  data-form="vclanitev"
  data-endpoint={site.forms.endpoint || undefined}
  data-mailto={site.forms.fallbackEmail}
  data-subject="Pristopna izjava – včlanitev"
  data-success="Hvala za vaš pristop! Oglasili se vam bomo z informacijami o članarini."
>
  <input type="hidden" name="_subject" value="Pristopna izjava – včlanitev" />
  <div class="form__row">
    <div class="field">
      <label for={`${id}-ime`}>Ime in priimek <span class="req">*</span></label>
      <input type="text" id={`${id}-ime`} name="ime" autocomplete="name" required />
    </div>
    <div class="field">
      <label for={`${id}-email`}>E-naslov <span class="req">*</span></label>
      <input type="email" id={`${id}-email`} name="email" autocomplete="email" required />
    </div>
  </div>
  <div class="form__row">
    <div class="field">
      <label for={`${id}-telefon`}>Telefon</label>
      <input type="tel" id={`${id}-telefon`} name="telefon" autocomplete="tel" />
    </div>
    <div class="field">
      <label for={`${id}-vrsta`}>Kdo ste?</label>
      <select id={`${id}-vrsta`} name="vrsta">
        <option>Vrtičkar ali vrtičkarka</option>
        <option>Kmet ali kmetica</option>
        <option>Družina</option>
        <option>Ustanova ali organizacija</option>
        <option>Podpornik ali podpornica</option>
      </select>
    </div>
  </div>
  <div class="field">
    <label for={`${id}-naslov`}>Naslov</label>
    <input type="text" id={`${id}-naslov`} name="naslov" autocomplete="street-address" />
    <p class="hint">Ulica, hišna številka, pošta in kraj.</p>
  </div>
  <div class="field">
    <label for={`${id}-sporocilo`}>Kaj vas zanima?</label>
    <textarea id={`${id}-sporocilo`} name="sporocilo"></textarea>
  </div>
  <label class="check" for={`${id}-izjava`}>
    <input type="checkbox" name="izjava" id={`${id}-izjava`} value="Da" required />
    <span>
      Izjavljam, da sem seznanjen/a z <a href={url('/drustvo/namen-in-cilji/')}>namenom, cilji</a> in načinom delovanja
      Društva za biološko-dinamično gospodarjenje Ajda Dolenjska (v nadaljevanju Društvo), da sem seznanjen/a s <a href={url('/dokumenti/statut-drustva.pdf')}>Statutom
      Društva</a> in sprejemam njegova določila ter da se želim včlaniti v Društvo.
    </span>
  </label>
  <FormTail
    id={id}
    submitLabel="Oddaj pristopnico"
    consent="Soglašam, da Društvo obdeluje moje podatke, ki so navedeni v tem obrazcu, in sicer za potrebe društva in v okviru njegove dejavnosti ter za izvrševanje mojih pravic in obveznosti, ki jih imam kot član/ica Društva."
  />
</form>
