---
import { Image } from 'astro:assets';
import { logo } from '@/assets/brand/logo';

interface Props {
  /** `badge`: the header badge, sized by the header. `footer`: the full logo on its own. */
  variant?: 'badge' | 'footer';
}
const { variant = 'badge' } = Astro.props;
const alt = 'Ajda Dolenjska, društvo za biološko-dinamično gospodarjenje';
---

<Image
  src={logo}
  alt={alt}
  widths={[120, 240, 360]}
  sizes={variant === 'badge' ? '6rem' : '10rem'}
  class:list={['logo', `logo--${variant}`]}
  loading={variant === 'badge' ? 'eager' : 'lazy'}
/>

<style>
  .logo {
    display: block;
    width: auto;
    max-width: none;
  }
  .logo--footer {
    height: 10rem;
  }
</style>
