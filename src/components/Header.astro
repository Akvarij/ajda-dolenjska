---
import { nav, utilityLinks, joinHref } from '@/data/nav';
import Icon from './Icon.astro';
import Logo from './Logo.astro';

const path = Astro.url.pathname;
const currentKey = nav.find((s) => path.startsWith(s.href))?.key;
---

<nav class="topbar" aria-label="Pomožne povezave">
  <div class="container topbar__inner">
    <ul>
      {
        utilityLinks.map((l) => (
          <li>
            <a href={l.href} aria-current={path.startsWith(l.href) ? 'page' : undefined}>
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>

<header class="site-header">
  <div class="container bar">
    <a class="brand" href="/" aria-label="Ajda Dolenjska – domov">
      <Logo />
    </a>

    <nav class="main-nav" aria-label="Glavna navigacija">
      <ul>
        {
          nav.map((s) => (
            <li class="nav-item">
              <a href={s.href} aria-current={s.key === currentKey ? 'true' : undefined}>
                {s.label}
                <Icon name="chevron-down" size={18} class="chev" />
              </a>
              <div class="dropdown">
                <ul>
                  {s.children.map((c) => (
                    <li>
                      <a href={c.href} aria-current={c.href === path ? 'page' : undefined}>
                        <Icon name={c.icon} size={20} />
                        <span>{c.label}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="actions">
      <a class="icon-btn" href="/iskanje/" aria-label="Iskanje po spletni strani">
        <Icon name="search" size={22} />
      </a>
      <a class="btn btn--sun btn--sm join" href={joinHref} data-join>Postani član</a>
      <button
        class="icon-btn menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Odpri meni"
      >
        <span class="open"><Icon name="menu" size={28} /></span>
        <span class="close"><Icon name="close" size={28} /></span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden>
    <div class="mobile-menu__panel">
      <form action="/iskanje/" method="get" role="search" class="m-search">
        <label for="m-q" class="sr-only">Iskanje</label>
        <input type="search" id="m-q" name="q" placeholder="Iščite po spletni strani" />
        <button class="btn btn--primary" type="submit">Išči</button>
      </form>

      {
        nav.map((s) => (
          <details class="m-group" open={s.key === currentKey}>
            <summary>
              <Icon name={s.icon} size={24} />
              <span>{s.label}</span>
              <Icon name="chevron-down" size={22} class="chev" />
            </summary>
            <ul>
              {s.children.map((c) => (
                <li>
                  <a href={c.href} aria-current={c.href === path ? 'page' : undefined}>
                    {c.label}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        ))
      }

      <div class="m-cta">
        <a class="btn btn--sun" href={joinHref} data-join>Postani član</a>
        <a class="btn btn--ghost" href="/drustvo/kontakt/">Kontakt</a>
      </div>
      <ul class="m-utility">
        {utilityLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </div>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const menu = document.getElementById('mobile-menu');
  if (toggle && menu) {
    const set = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Zapri meni' : 'Odpri meni');
      menu.hidden = !open;
      document.body.classList.toggle('menu-open', open);
    };
    toggle.addEventListener('click', () => set(menu.hidden));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) {
        set(false);
        toggle.focus();
      }
    });
    window.matchMedia('(min-width: 1260px)').addEventListener('change', (e) => {
      if (e.matches) set(false);
    });
  }
</script>

<style>
  /* ---------- slim utility links above the floating bar ---------- */
  .topbar {
    position: relative;
    z-index: 51;
    font-size: 0.85rem;
  }
  .topbar__inner {
    display: none;
    justify-content: flex-end;
    align-items: center;
    height: var(--topbar-h);
  }
  .topbar ul {
    display: flex;
    gap: 1.6rem;
    margin: 0;
    padding: 0 1.5rem 0 0;
    list-style: none;
  }
  .topbar a {
    color: var(--c-green-deep);
    font-weight: 600;
    text-decoration: none;
    opacity: 0.85;
  }
  .topbar a:hover,
  .topbar a[aria-current] {
    opacity: 1;
    text-decoration: underline;
  }

  /* ---------- floating glass bar ---------- */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    padding-block: 0.45rem;
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.6rem;
    padding: 0.3rem 0.4rem 0.3rem 1.25rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.62);
    border: 1px solid rgb(255 255 255 / 0.75);
    box-shadow: 0 10px 30px -18px rgb(32 51 28 / 0.35);
    backdrop-filter: saturate(1.6) blur(16px);
    -webkit-backdrop-filter: saturate(1.6) blur(16px);
    transition:
      background-color 0.35s,
      box-shadow 0.35s,
      border-color 0.35s;
  }
  .site-header.is-scrolled .bar,
  :global(body.menu-open) .bar {
    background: rgb(255 255 255 / 0.92);
    border-color: var(--c-line);
    box-shadow: 0 14px 34px -16px rgb(32 51 28 / 0.32);
  }
  .brand {
    display: block;
    flex: none;
  }
  .brand :global(.logo--header) {
    height: 2.6rem;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }
  .icon-btn {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--c-green-deep);
    cursor: pointer;
    transition: background-color 0.15s;
  }
  .icon-btn:hover {
    background: var(--c-tint-strong);
    color: var(--c-green-deep);
  }
  .menu-toggle .close,
  .menu-toggle[aria-expanded='true'] .open {
    display: none;
  }
  .menu-toggle[aria-expanded='true'] .close {
    display: inline;
  }
  .join {
    display: none;
  }
  @media (min-width: 640px) {
    .join {
      display: inline-flex;
    }
  }

  .main-nav {
    display: none;
  }

  /* ---------- mobile menu: a card that drops below the bar ---------- */
  .mobile-menu {
    width: min(100% - 2 * var(--gutter), var(--container));
    margin: 0.5rem auto 0;
  }
  .mobile-menu[hidden] {
    display: none;
  }
  .mobile-menu__panel {
    max-height: calc(100dvh - var(--header-h) - 1.5rem);
    overflow-y: auto;
    padding: 1.1rem clamp(1rem, 4vw, 1.5rem) 1.5rem;
    background: #fff;
    border: 1px solid var(--c-line);
    border-radius: 24px;
    box-shadow: var(--shadow);
    animation: menu-in 0.3s var(--ease-out);
  }
  @keyframes menu-in {
    from {
      opacity: 0;
      translate: 0 -8px;
    }
  }
  .m-search {
    display: flex;
    gap: 0.6rem;
    margin-bottom: 0.75rem;
  }
  .m-search input {
    flex: 1;
  }
  .m-group {
    border-bottom: 1px solid var(--c-line);
  }
  .m-group summary {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem 0.25rem;
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 500;
    cursor: pointer;
    list-style: none;
  }
  .m-group summary::-webkit-details-marker {
    display: none;
  }
  .m-group summary :global(svg:first-child) {
    color: var(--c-brand);
  }
  .m-group summary span {
    flex: 1;
  }
  .m-group :global(.chev) {
    transition: transform 0.2s;
  }
  .m-group[open] :global(.chev) {
    transform: rotate(180deg);
  }
  .m-group ul {
    margin: 0 0 0.85rem;
    padding: 0 0 0 2.2rem;
    list-style: none;
  }
  .m-group li a {
    display: block;
    padding: 0.5rem 0;
    font-weight: 600;
    text-decoration: none;
    color: var(--c-ink);
  }
  .m-group li a[aria-current] {
    color: var(--c-green);
  }
  .m-cta {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }
  .m-utility {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin: 1.1rem 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.95rem;
  }
  .m-utility a {
    font-weight: 700;
  }

  /* ---------- desktop ---------- */
  @media (min-width: 1260px) {
    .topbar__inner {
      display: flex;
    }
    .main-nav {
      display: block;
    }
    .menu-toggle,
    .mobile-menu {
      display: none !important;
    }
    .main-nav > ul {
      display: flex;
      gap: 0.1rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }
    .nav-item {
      position: relative;
    }
    .nav-item > a {
      position: relative;
      display: inline-flex;
      align-items: center;
      gap: 0.2rem;
      padding: 0.6rem 0.85rem;
      border-radius: 999px;
      font-size: 0.95rem;
      font-weight: 600;
      color: var(--c-ink);
      text-decoration: none;
      white-space: nowrap;
      transition:
        background-color 0.2s,
        color 0.2s;
    }
    .nav-item > a :global(.chev) {
      width: 16px;
      height: 16px;
      color: var(--c-brand);
      transition: transform 0.25s var(--ease-out);
    }
    .nav-item:hover > a,
    .nav-item:focus-within > a {
      background: rgb(243 248 230 / 0.9);
      color: var(--c-green-deep);
    }
    .nav-item:hover > a :global(.chev),
    .nav-item:focus-within > a :global(.chev) {
      transform: rotate(180deg);
    }
    /* current section: a small sun-coloured underline */
    .nav-item > a[aria-current]::after {
      content: '';
      position: absolute;
      left: 0.85rem;
      right: 1.85rem;
      bottom: 0.3rem;
      height: 2px;
      border-radius: 2px;
      background: linear-gradient(90deg, var(--c-sun), var(--c-brand));
    }
    .nav-item > a[aria-current] {
      color: var(--c-green-deep);
    }

    .dropdown {
      position: absolute;
      top: 100%;
      left: 50%;
      min-width: 19rem;
      padding-top: 0.85rem;
      translate: -50% 8px;
      visibility: hidden;
      opacity: 0;
      transition:
        opacity 0.2s,
        visibility 0.2s,
        translate 0.25s var(--ease-out);
    }
    .nav-item:nth-last-child(-n + 2) .dropdown {
      left: auto;
      right: 0;
      translate: 0 8px;
    }
    .nav-item:hover .dropdown,
    .nav-item:focus-within .dropdown {
      visibility: visible;
      opacity: 1;
      translate: -50% 0;
    }
    .nav-item:nth-last-child(-n + 2):hover .dropdown,
    .nav-item:nth-last-child(-n + 2):focus-within .dropdown {
      translate: none;
    }
    .dropdown ul {
      margin: 0;
      padding: 0.5rem;
      list-style: none;
      background: #fff;
      border: 1px solid var(--c-line);
      border-radius: 22px;
      box-shadow: var(--shadow);
    }
    .dropdown a {
      display: flex;
      align-items: center;
      gap: 0.8rem;
      padding: 0.65rem 0.9rem;
      border-radius: 14px;
      font-size: 0.95rem;
      font-weight: 600;
      color: var(--c-ink);
      text-decoration: none;
      transition:
        background-color 0.15s,
        padding-left 0.25s var(--ease-out);
    }
    .dropdown a :global(svg) {
      color: var(--c-brand);
      flex: none;
    }
    .dropdown a:hover,
    .dropdown a:focus-visible {
      padding-left: 1.15rem;
      background: var(--c-tint);
      color: var(--c-green-deep);
    }
    .dropdown a[aria-current] {
      background: var(--c-tint-strong);
    }
  }
</style>
