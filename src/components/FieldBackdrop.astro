---
/**
 * Field backdrop: a still photo and, over the default buckwheat field, a
 * painted blue sky and a soft sun. Nothing moves: the client found zooming
 * photos, bees and pollen restless (and they cost frames on slower devices).
 * `hero` is the full-bleed home version, `calm` sits on the right of page
 * headers. `photo` defaults to the buckwheat field.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import field from '@/assets/photos/ajdovo-polje.jpg';

interface Props {
  variant?: 'hero' | 'calm';
  photo?: ImageMetadata;
  /** Which part of the photo to keep in view when it is cropped (CSS object-position). */
  focus?: string;
  class?: string;
}
const { variant = 'hero', photo = field, focus, class: className } = Astro.props;
const hero = variant === 'hero';
// The buckwheat photo has a hazy white sky, so it gets a blue tint and a drawn sun.
// Other photos keep their own sky and light.
const paintSky = photo === field;
---

<div
  class:list={['field', `field--${variant}`, className]}
  style={focus && `--focus:${focus}`}
  aria-hidden="true"
>
  <div class="field__frame">
    <Image
      class="field__photo"
      src={photo}
      alt=""
      widths={(hero ? [800, 1280, 1800, 2400] : [800, 1280, 1800]).filter((w) => w <= photo.width)}
      // On portrait screens the photo is cropped to the screen's height, so it needs to be
      // about 1.5× that wide; sizing by width alone made phones load a blurry, too-small copy.
      sizes={hero ? '(orientation: portrait) 150vh, 100vw' : '(min-width: 900px) 60vw, (orientation: portrait) 100vh, 100vw'}
      quality={85}
      loading={hero ? 'eager' : 'lazy'}
      fetchpriority={hero ? 'high' : 'auto'}
    />
    {paintSky && <div class="field__sky" />}
  </div>
  {paintSky && <div class="field__sun" />}
</div>

<style>
  .field {
    position: absolute;
    inset: 0;
    overflow: hidden;
    container-type: size;
    pointer-events: none;
  }
  .field > * {
    position: absolute;
    inset: 0;
  }

  /* ---------- the photo, still ---------- */
  .field__frame {
    isolation: isolate;
  }
  .field__frame :global(.field__photo) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--focus, 50% 62%);
  }

  /* ---------- the hazy sky turns into a sunny one ---------- */
  .field__sky {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      var(--c-blue) 0%,
      #b3dbf1 18%,
      #dcefee 32%,
      #fff3d2 42%,
      #ffffff 52%
    );
    mix-blend-mode: multiply;
  }
  /* a still sun: a white-hot core with a soft warm glow that lights up the sky */
  .field > .field__sun {
    inset: auto;
    left: 80%;
    top: 24%;
    width: clamp(16rem, 26vw, 24rem);
    aspect-ratio: 1;
    translate: -50% -50%;
    background: radial-gradient(
      circle closest-side,
      #fff 0,
      #fffef8 9%,
      rgb(255 248 220 / 0.95) 12%,
      rgb(255 236 180 / 0.7) 16%,
      rgb(255 226 150 / 0.4) 26%,
      rgb(255 220 140 / 0.18) 46%,
      rgb(255 220 140 / 0) 100%
    );
    mix-blend-mode: screen;
  }
  /* on narrow screens the hero text covers the middle: keep the sun above it */
  @media (max-width: 959px) {
    .field--hero > .field__sun {
      top: 14%;
    }
  }
  .field--calm > .field__sun {
    left: 64%;
    top: 40%;
    width: clamp(11rem, 18vw, 16rem);
  }

  /* ---------- page-header variant: photo only on the right, softer ---------- */
  .field--calm {
    left: auto;
    width: min(70%, 62rem);
    -webkit-mask-image: linear-gradient(90deg, transparent 0, rgb(0 0 0 / 0.6) 28%, #000 60%);
    mask-image: linear-gradient(90deg, transparent 0, rgb(0 0 0 / 0.6) 28%, #000 60%);
  }
  .field--calm .field__frame :global(.field__photo) {
    object-position: var(--focus, 50% 42%);
  }
  @media (max-width: 700px) {
    .field--calm {
      width: 100%;
      opacity: 0.45;
    }
  }
</style>
