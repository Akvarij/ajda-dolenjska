---
/**
 * Animated field backdrop: a photo with a sunny sky tint, slowly drifting
 * clouds, sun rays, floating pollen and buckwheat blossoms carried by the wind.
 * Everything moving is decorative and stops for visitors who prefer reduced
 * motion. `hero` is the full version for the home page, `calm` a lighter one
 * for page headers.
 */
import { Image } from 'astro:assets';
import field from '@/assets/photos/polje-ajde.jpg';

interface Props {
  variant?: 'hero' | 'calm';
  class?: string;
}
const { variant = 'hero', class: className } = Astro.props;
const hero = variant === 'hero';

// Deterministic pseudo-random numbers so every build renders the same scene.
let seed = hero ? 11 : 5;
const rand = () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;
const between = (a: number, b: number) => a + rand() * (b - a);

const motes = Array.from({ length: hero ? 18 : 9 }, () => ({
  left: between(2, 98).toFixed(1),
  size: between(4, 9).toFixed(1),
  dur: between(14, 26).toFixed(1),
  delay: (-between(0, 26)).toFixed(1),
  sway: between(10, 26).toFixed(0),
}));
const petals = hero
  ? Array.from({ length: 9 }, () => ({
      top: between(4, 70).toFixed(1),
      size: between(10, 18).toFixed(1),
      dur: between(18, 32).toFixed(1),
      delay: (-between(0, 32)).toFixed(1),
      fall: between(12, 34).toFixed(0),
      pink: rand() > 0.6,
    }))
  : [];

const petal =
  'M0-7c2.2 0 2.6 3.3 0 5.4C-2.6-3.7-2.2-7 0-7zm6.7 2.2C7.4-2.7 4.7-.9 2.2-1.9c1.5-2.3 3.8-4.9 4.5-2.9zM4.1 5.7C2.4 7 .9 4.1 1.5 1.5c2.6.9 4.3 2.9 2.6 4.2zm-8.2 0C-5.8 4.4-4.1 2.4-1.5 1.5c.6 2.6-.9 5.5-2.6 4.2zM-6.7-2.8C-6-4.7-3.7-2.2-2.2-1.9-4.7-.9-7.4-2.7-6.7-2.8z';
---

<div class:list={['field', `field--${variant}`, className]} aria-hidden="true">
  <div class="field__zoom">
    <Image
      class="field__photo"
      src={field}
      alt=""
      widths={hero ? [800, 1280, 1800, 2400] : [800, 1280, 1800]}
      sizes={hero ? '100vw' : '(min-width: 900px) 60vw, 100vw'}
      loading={hero ? 'eager' : 'lazy'}
      fetchpriority={hero ? 'high' : 'auto'}
    />
    <div class="field__sky"></div>
  </div>
  <div class="field__rays motion-only"></div>
  <div class="field__sun"></div>
  <div class="field__clouds motion-only">
    <span class="cloud cloud--1"></span>
    <span class="cloud cloud--2"></span>
    <span class="cloud cloud--3"></span>
  </div>
  <div class="field__wash"></div>
  <div class="field__drift motion-only">
    {
      motes.map((m) => (
        <span
          class="mote"
          style={`--x:${m.left}%;--s:${m.size}px;--dur:${m.dur}s;--delay:${m.delay}s;--sway:${m.sway}px`}
        />
      ))
    }
    {
      petals.map((p) => (
        <svg
          class:list={['petal', { 'petal--pink': p.pink }]}
          viewBox="-8 -8 16 16"
          style={`--y:${p.top}%;--s:${p.size}px;--dur:${p.dur}s;--delay:${p.delay}s;--fall:${p.fall}cqh`}
        >
          <path d={petal} />
          <circle r="1.6" />
        </svg>
      ))
    }
  </div>
  {
    hero && (
      <div class="field__flutter motion-only">
        <span class="fly fly--1">
          <span class="fly__path">
            <svg class="butterfly" viewBox="-20 -16 40 32">
              <g class="wing wing--l">
                <path d="M-1-2C-6-15-19-14-17-5-16 0-8 1-1 0z" />
                <path d="M-1 1C-9 2-14 9-10 13-6 15-2 8-1 2z" />
              </g>
              <g class="wing wing--r">
                <path d="M1-2C6-15 19-14 17-5 16 0 8 1 1 0z" />
                <path d="M1 1C9 2 14 9 10 13 6 15 2 8 1 2z" />
              </g>
              <rect class="butterfly__body" x="-1.2" y="-6" width="2.4" height="15" rx="1.2" />
            </svg>
          </span>
        </span>
        <span class="fly fly--2">
          <span class="fly__path">
            <svg class="butterfly butterfly--white" viewBox="-20 -16 40 32">
              <g class="wing wing--l">
                <path d="M-1-2C-6-15-19-14-17-5-16 0-8 1-1 0z" />
                <path d="M-1 1C-9 2-14 9-10 13-6 15-2 8-1 2z" />
              </g>
              <g class="wing wing--r">
                <path d="M1-2C6-15 19-14 17-5 16 0 8 1 1 0z" />
                <path d="M1 1C9 2 14 9 10 13 6 15 2 8 1 2z" />
              </g>
              <rect class="butterfly__body" x="-1.2" y="-6" width="2.4" height="15" rx="1.2" />
            </svg>
          </span>
        </span>
      </div>
    )
  }
</div>

<style>
  .field {
    position: absolute;
    inset: 0;
    overflow: hidden;
    container-type: size;
    pointer-events: none;
  }
  .field > * {
    position: absolute;
    inset: 0;
  }

  /* ---------- photo, very slowly breathing in ---------- */
  .field__zoom {
    isolation: isolate;
    animation: slow-zoom 34s ease-in-out infinite alternate;
    will-change: transform;
  }
  .field__zoom :global(.field__photo) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 62%;
  }
  @keyframes slow-zoom {
    from {
      transform: scale(1.02);
    }
    to {
      transform: scale(1.12) translate(-1.5%, 1%);
    }
  }

  /* ---------- the hazy sky turns into a sunny one ---------- */
  /* tinted together with the photo, so it stays on the horizon while zooming */
  .field__sky {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      #86c6ea 0%,
      #b3dbf1 18%,
      #dcefee 32%,
      #fff3d2 42%,
      #ffffff 52%
    );
    mix-blend-mode: multiply;
  }
  .field__sun {
    background:
      radial-gradient(circle at 80% 10%, rgb(255 246 214 / 0.95) 0, rgb(255 226 140 / 0.55) 7%, transparent 26%),
      radial-gradient(circle at 80% 10%, rgb(255 236 170 / 0.35) 0, transparent 50%);
    animation: sun-pulse 9s ease-in-out infinite alternate;
  }
  @keyframes sun-pulse {
    to {
      opacity: 0.75;
    }
  }
  .field__rays {
    inset: -60%;
    background: repeating-conic-gradient(
      from 0deg at 50% 50%,
      rgb(255 244 205 / 0.26) 0deg 3deg,
      transparent 3deg 13deg
    );
    -webkit-mask-image: radial-gradient(circle at 50% 50%, #000 0, rgb(0 0 0 / 0.4) 18%, transparent 36%);
    mask-image: radial-gradient(circle at 50% 50%, #000 0, rgb(0 0 0 / 0.4) 18%, transparent 36%);
    /* centre the rotating disc on the sun (80% / 10% of the field):
       the disc is 220% of the field, so 30% / -40% of the field = 13.6% / -18.2% of it */
    translate: 13.6% -18.2%;
    animation: rays 120s linear infinite;
  }
  @keyframes rays {
    to {
      rotate: 360deg;
    }
  }

  /* ---------- light wash behind the text ---------- */
  .field--hero .field__wash {
    background:
      linear-gradient(0deg, var(--c-bg) 0, rgb(255 253 247 / 0) 14%),
      linear-gradient(
        90deg,
        rgb(255 253 247 / 0.94) 0,
        rgb(255 253 247 / 0.84) 30%,
        rgb(255 253 247 / 0.32) 54%,
        rgb(255 253 247 / 0) 70%
      );
  }
  @media (max-width: 959px) {
    .field--hero .field__wash {
      background:
        linear-gradient(0deg, var(--c-bg) 0, rgb(255 253 247 / 0) 14%),
        linear-gradient(
          180deg,
          rgb(255 253 247 / 0.3) 0,
          rgb(255 253 247 / 0.8) 28%,
          rgb(255 253 247 / 0.8) 70%,
          rgb(255 253 247 / 0.1) 100%
        );
    }
  }

  /* ---------- clouds ---------- */
  .cloud {
    position: absolute;
    left: 0;
    width: 22rem;
    height: 6rem;
    border-radius: 50%;
    background:
      radial-gradient(closest-side at 30% 60%, #fff 0, rgb(255 255 255 / 0.85) 55%, transparent 100%),
      radial-gradient(closest-side at 62% 45%, #fff 0, rgb(255 255 255 / 0.8) 50%, transparent 100%),
      radial-gradient(closest-side at 80% 65%, #fff 0, rgb(255 255 255 / 0.7) 45%, transparent 100%);
    filter: blur(6px);
    opacity: 0.85;
    animation: cloud-drift var(--dur) linear var(--delay) infinite;
  }
  .cloud--1 {
    top: 8%;
    --dur: 95s;
    --delay: -30s;
  }
  .cloud--2 {
    top: 20%;
    width: 15rem;
    height: 4.5rem;
    opacity: 0.7;
    --dur: 130s;
    --delay: -95s;
  }
  .cloud--3 {
    top: 4%;
    width: 11rem;
    height: 3.5rem;
    opacity: 0.6;
    --dur: 160s;
    --delay: -20s;
  }
  @keyframes cloud-drift {
    from {
      translate: -25rem 0;
    }
    to {
      translate: calc(100cqw + 2rem) 0;
    }
  }

  /* ---------- pollen rising in the warm air ---------- */
  .mote {
    position: absolute;
    left: var(--x);
    top: 100%;
    width: var(--s);
    height: var(--s);
    border-radius: 50%;
    background: radial-gradient(circle, #fffbe6 0, #ffe07a 45%, rgb(246 192 74 / 0) 72%);
    box-shadow: 0 0 10px 2px rgb(255 226 130 / 0.55);
    opacity: 0;
    animation: mote-rise var(--dur) linear var(--delay) infinite;
  }
  @keyframes mote-rise {
    0% {
      opacity: 0;
      translate: 0 0;
    }
    10% {
      opacity: 0.95;
    }
    25% {
      translate: var(--sway) -28cqh;
    }
    50% {
      translate: calc(var(--sway) * -1) -56cqh;
    }
    75% {
      translate: var(--sway) -84cqh;
    }
    88% {
      opacity: 0.8;
    }
    100% {
      opacity: 0;
      translate: 0 -112cqh;
    }
  }

  /* ---------- buckwheat blossoms carried by the wind ---------- */
  .petal {
    position: absolute;
    left: 0;
    top: var(--y);
    width: var(--s);
    height: var(--s);
    fill: #fff;
    opacity: 0;
    filter: drop-shadow(0 2px 3px rgb(32 51 28 / 0.25));
    animation: blow var(--dur) linear var(--delay) infinite;
  }
  .petal circle {
    fill: #f6c04a;
  }
  .petal--pink {
    fill: #fbd3d7;
  }
  @keyframes blow {
    0% {
      opacity: 0;
      translate: -3rem 0;
      rotate: 0deg;
    }
    8% {
      opacity: 0.95;
    }
    30% {
      translate: 30cqw calc(var(--fall) * 0.2);
    }
    55% {
      translate: 55cqw calc(var(--fall) * 0.65);
    }
    80% {
      translate: 82cqw calc(var(--fall) * 0.55);
    }
    92% {
      opacity: 0.9;
    }
    100% {
      opacity: 0;
      translate: calc(100cqw + 2rem) var(--fall);
      rotate: 600deg;
    }
  }

  /* ---------- butterflies ---------- */
  .fly {
    position: absolute;
    inset: auto;
    animation: fly-x var(--fx) ease-in-out infinite alternate;
  }
  .fly__path {
    display: block;
    animation: fly-y var(--fy) ease-in-out infinite alternate;
  }
  .fly--1 {
    left: 58%;
    top: 30%;
    --fx: 11s;
    --fy: 3.7s;
    --range-x: 22cqw;
    --range-y: 12cqh;
  }
  .fly--2 {
    left: 72%;
    top: 58%;
    --fx: 14s;
    --fy: 4.6s;
    --range-x: -18cqw;
    --range-y: -10cqh;
  }
  @keyframes fly-x {
    from {
      translate: 0 0;
      rotate: -8deg;
    }
    50% {
      rotate: 10deg;
    }
    to {
      translate: var(--range-x) 0;
      rotate: -4deg;
    }
  }
  @keyframes fly-y {
    from {
      translate: 0 0;
    }
    to {
      translate: 0 var(--range-y);
    }
  }
  .butterfly {
    display: block;
    width: 2.4rem;
    height: auto;
    overflow: visible;
    filter: drop-shadow(0 4px 4px rgb(32 51 28 / 0.25));
  }
  .fly--2 .butterfly {
    width: 1.8rem;
  }
  .wing {
    fill: #f7d84f;
    stroke: #d9a91a;
    stroke-width: 0.6;
    transform-box: view-box;
    transform-origin: 0 0;
    animation: flap 0.32s ease-in-out infinite alternate;
  }
  .butterfly--white .wing {
    fill: #fffdf5;
    stroke: #c9cdb8;
    animation-duration: 0.26s;
  }
  .butterfly__body {
    fill: #4a3b22;
  }
  @keyframes flap {
    to {
      transform: scaleX(0.25);
    }
  }

  /* ---------- page-header variant: photo only on the right, softer ---------- */
  .field--calm {
    left: auto;
    width: min(70%, 62rem);
    -webkit-mask-image: linear-gradient(90deg, transparent 0, rgb(0 0 0 / 0.6) 28%, #000 60%);
    mask-image: linear-gradient(90deg, transparent 0, rgb(0 0 0 / 0.6) 28%, #000 60%);
  }
  .field--calm .field__zoom {
    animation-duration: 50s;
  }
  .field--calm .field__zoom :global(.field__photo) {
    object-position: 50% 42%;
  }
  .field--calm .cloud {
    filter: blur(8px);
  }
  @media (max-width: 700px) {
    .field--calm {
      width: 100%;
      opacity: 0.45;
    }
  }
</style>
