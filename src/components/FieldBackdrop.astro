---
/**
 * Animated field backdrop: a photo with a sunny sky tint, a still sun,
 * floating pollen, buckwheat blossoms carried by the wind and, on the home
 * page, bees. Everything moving is decorative and stops for visitors who
 * prefer reduced motion. `hero` is the full, unclouded version for the home
 * page, `calm` a lighter one with drifting clouds for page headers.
 */
import { Image } from 'astro:assets';
import field from '@/assets/photos/polje-ajde.jpg';

interface Props {
  variant?: 'hero' | 'calm';
  class?: string;
}
const { variant = 'hero', class: className } = Astro.props;
const hero = variant === 'hero';

// Deterministic pseudo-random numbers so every build renders the same scene.
let seed = hero ? 11 : 5;
const rand = () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;
const between = (a: number, b: number) => a + rand() * (b - a);

const motes = Array.from({ length: hero ? 18 : 9 }, () => ({
  left: between(2, 98).toFixed(1),
  size: between(4, 9).toFixed(1),
  dur: between(14, 26).toFixed(1),
  delay: (-between(0, 26)).toFixed(1),
  sway: between(10, 26).toFixed(0),
}));
const petals = hero
  ? Array.from({ length: 9 }, () => ({
      top: between(4, 70).toFixed(1),
      size: between(10, 18).toFixed(1),
      dur: between(18, 32).toFixed(1),
      delay: (-between(0, 32)).toFixed(1),
      fall: between(12, 34).toFixed(0),
      pink: rand() > 0.6,
    }))
  : [];

const petal =
  'M0-7c2.2 0 2.6 3.3 0 5.4C-2.6-3.7-2.2-7 0-7zm6.7 2.2C7.4-2.7 4.7-.9 2.2-1.9c1.5-2.3 3.8-4.9 4.5-2.9zM4.1 5.7C2.4 7 .9 4.1 1.5 1.5c2.6.9 4.3 2.9 2.6 4.2zm-8.2 0C-5.8 4.4-4.1 2.4-1.5 1.5c.6 2.6-.9 5.5-2.6 4.2zM-6.7-2.8C-6-4.7-3.7-2.2-2.2-1.9-4.7-.9-7.4-2.7-6.7-2.8z';

// Which way each bee sets off: they are drawn facing right, -1 flies left first.
const bees = hero ? [1, -1, -1] : [];
---

<div class:list={['field', `field--${variant}`, className]} aria-hidden="true">
  <div class="field__zoom">
    <Image
      class="field__photo"
      src={field}
      alt=""
      widths={hero ? [800, 1280, 1800, 2400] : [800, 1280, 1800]}
      sizes={hero ? '100vw' : '(min-width: 900px) 60vw, 100vw'}
      loading={hero ? 'eager' : 'lazy'}
      fetchpriority={hero ? 'high' : 'auto'}
    />
    <div class="field__sky"></div>
  </div>
  <div class="field__sun"></div>
  {
    !hero && (
      <div class="field__clouds motion-only">
        <span class="cloud cloud--1" />
        <span class="cloud cloud--2" />
        <span class="cloud cloud--3" />
      </div>
    )
  }
  <div class="field__drift motion-only">
    {
      motes.map((m) => (
        <span
          class="mote"
          style={`--x:${m.left}%;--s:${m.size}px;--dur:${m.dur}s;--delay:${m.delay}s;--sway:${m.sway}px`}
        />
      ))
    }
    {
      petals.map((p) => (
        <svg
          class:list={['petal', { 'petal--pink': p.pink }]}
          viewBox="-8 -8 16 16"
          style={`--y:${p.top}%;--s:${p.size}px;--dur:${p.dur}s;--delay:${p.delay}s;--fall:${p.fall}cqh`}
        >
          <path d={petal} />
          <circle r="1.6" />
        </svg>
      ))
    }
  </div>
  {
    hero && (
      <div class="field__buzz motion-only">
        {bees.map((face, i) => (
          <span class={`bee-fly bee-fly--${i + 1}`} style={`--face:${face}`}>
            <span class="bee-fly__path">
              <svg class="bee" viewBox="-24 -22 48 36">
                <defs>
                  <clipPath id={`bee-body-${i}`}>
                    <ellipse cx="0" cy="2" rx="12" ry="8.5" />
                  </clipPath>
                </defs>
                <g class="bee__wing bee__wing--back">
                  <ellipse cx="-4" cy="-8" rx="5" ry="9" transform="rotate(-28 -4 -8)" />
                </g>
                <path class="bee__sting" d="M-11 .6-17 2.6-11 4.6z" />
                <ellipse class="bee__body" cx="0" cy="2" rx="12" ry="8.5" />
                <g clip-path={`url(#bee-body-${i})`} class="bee__stripes">
                  <rect x="-8.5" y="-8" width="3.4" height="20" />
                  <rect x="-1.6" y="-8" width="3.4" height="20" />
                  <rect x="5.2" y="-8" width="2.8" height="20" />
                </g>
                <ellipse class="bee__outline" cx="0" cy="2" rx="12" ry="8.5" />
                <path class="bee__antenna" d="M13.5-3.5c.5-3 2-5 4.5-5.5M11.5-4c-.3-3 .5-5.5 2.5-6.5" />
                <circle class="bee__head" cx="12.5" cy="1" r="5" />
                <circle class="bee__eye" cx="14.6" cy="-.2" r="1.3" />
                <g class="bee__wing">
                  <ellipse cx="1.5" cy="-9.5" rx="5.5" ry="10" transform="rotate(16 1.5 -9.5)" />
                </g>
              </svg>
            </span>
          </span>
        ))}
      </div>
    )
  }
</div>

<style>
  .field {
    position: absolute;
    inset: 0;
    overflow: hidden;
    container-type: size;
    pointer-events: none;
  }
  .field > * {
    position: absolute;
    inset: 0;
  }

  /* ---------- photo, very slowly breathing in ---------- */
  .field__zoom {
    isolation: isolate;
    animation: slow-zoom 34s ease-in-out infinite alternate;
    will-change: transform;
  }
  .field__zoom :global(.field__photo) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 62%;
  }
  @keyframes slow-zoom {
    from {
      transform: scale(1.02);
    }
    to {
      transform: scale(1.12) translate(-1.5%, 1%);
    }
  }

  /* ---------- the hazy sky turns into a sunny one ---------- */
  /* tinted together with the photo, so it stays on the horizon while zooming */
  .field__sky {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      #86c6ea 0%,
      #b3dbf1 18%,
      #dcefee 32%,
      #fff3d2 42%,
      #ffffff 52%
    );
    mix-blend-mode: multiply;
  }
  /* a still sun: a white-hot core with a soft warm glow that lights up the sky */
  .field > .field__sun {
    inset: auto;
    left: 80%;
    top: 24%;
    width: clamp(16rem, 26vw, 24rem);
    aspect-ratio: 1;
    translate: -50% -50%;
    background: radial-gradient(
      circle closest-side,
      #fff 0,
      #fffef8 9%,
      rgb(255 248 220 / 0.95) 12%,
      rgb(255 236 180 / 0.7) 16%,
      rgb(255 226 150 / 0.4) 26%,
      rgb(255 220 140 / 0.18) 46%,
      rgb(255 220 140 / 0) 100%
    );
    mix-blend-mode: screen;
  }
  /* on narrow screens the hero text covers the middle: keep the sun above it */
  @media (max-width: 959px) {
    .field--hero > .field__sun {
      top: 14%;
    }
  }
  .field--calm > .field__sun {
    left: 64%;
    top: 40%;
    width: clamp(11rem, 18vw, 16rem);
  }

  /* ---------- clouds ---------- */
  .cloud {
    position: absolute;
    left: 0;
    width: 22rem;
    height: 6rem;
    border-radius: 50%;
    background:
      radial-gradient(closest-side at 30% 60%, #fff 0, rgb(255 255 255 / 0.85) 55%, transparent 100%),
      radial-gradient(closest-side at 62% 45%, #fff 0, rgb(255 255 255 / 0.8) 50%, transparent 100%),
      radial-gradient(closest-side at 80% 65%, #fff 0, rgb(255 255 255 / 0.7) 45%, transparent 100%);
    filter: blur(6px);
    opacity: 0.85;
    animation: cloud-drift var(--dur) linear var(--delay) infinite;
  }
  .cloud--1 {
    top: 8%;
    --dur: 95s;
    --delay: -30s;
  }
  .cloud--2 {
    top: 20%;
    width: 15rem;
    height: 4.5rem;
    opacity: 0.7;
    --dur: 130s;
    --delay: -95s;
  }
  .cloud--3 {
    top: 4%;
    width: 11rem;
    height: 3.5rem;
    opacity: 0.6;
    --dur: 160s;
    --delay: -20s;
  }
  @keyframes cloud-drift {
    from {
      translate: -25rem 0;
    }
    to {
      translate: calc(100cqw + 2rem) 0;
    }
  }

  /* ---------- pollen rising in the warm air ---------- */
  .mote {
    position: absolute;
    left: var(--x);
    top: 100%;
    width: var(--s);
    height: var(--s);
    border-radius: 50%;
    background: radial-gradient(circle, #fffbe6 0, #ffe07a 45%, rgb(246 192 74 / 0) 72%);
    box-shadow: 0 0 10px 2px rgb(255 226 130 / 0.55);
    opacity: 0;
    animation: mote-rise var(--dur) linear var(--delay) infinite;
  }
  @keyframes mote-rise {
    0% {
      opacity: 0;
      translate: 0 0;
    }
    10% {
      opacity: 0.95;
    }
    25% {
      translate: var(--sway) -28cqh;
    }
    50% {
      translate: calc(var(--sway) * -1) -56cqh;
    }
    75% {
      translate: var(--sway) -84cqh;
    }
    88% {
      opacity: 0.8;
    }
    100% {
      opacity: 0;
      translate: 0 -112cqh;
    }
  }

  /* ---------- buckwheat blossoms carried by the wind ---------- */
  .petal {
    position: absolute;
    left: 0;
    top: var(--y);
    width: var(--s);
    height: var(--s);
    fill: #fff;
    opacity: 0;
    filter: drop-shadow(0 2px 3px rgb(32 51 28 / 0.25));
    animation: blow var(--dur) linear var(--delay) infinite;
  }
  .petal circle {
    fill: #f6c04a;
  }
  .petal--pink {
    fill: #fbd3d7;
  }
  @keyframes blow {
    0% {
      opacity: 0;
      translate: -3rem 0;
      rotate: 0deg;
    }
    8% {
      opacity: 0.95;
    }
    30% {
      translate: 30cqw calc(var(--fall) * 0.2);
    }
    55% {
      translate: 55cqw calc(var(--fall) * 0.65);
    }
    80% {
      translate: 82cqw calc(var(--fall) * 0.55);
    }
    92% {
      opacity: 0.9;
    }
    100% {
      opacity: 0;
      translate: calc(100cqw + 2rem) var(--fall);
      rotate: 600deg;
    }
  }

  /* ---------- bees: out and back, turning round at each end ---------- */
  .bee-fly {
    position: absolute;
    inset: auto;
    animation: bee-x var(--fx) ease-in-out infinite;
  }
  .bee-fly__path {
    display: block;
    animation: bee-y var(--fy) ease-in-out infinite alternate;
  }
  .bee-fly--1 {
    left: 52%;
    top: 34%;
    --fx: 12s;
    --fy: 1.9s;
    --range-x: 26cqw;
    --range-y: 7cqh;
  }
  .bee-fly--2 {
    left: 86%;
    top: 56%;
    --fx: 15s;
    --fy: 2.4s;
    --range-x: -24cqw;
    --range-y: -9cqh;
  }
  .bee-fly--3 {
    left: 74%;
    top: 74%;
    --fx: 10s;
    --fy: 1.6s;
    --range-x: -14cqw;
    --range-y: 5cqh;
  }
  /* on narrow screens, fly above and below the hero text instead */
  @media (max-width: 959px) {
    .bee-fly--1 {
      left: 12%;
      top: 12%;
    }
    .bee-fly--3 {
      top: 90%;
    }
  }
  @keyframes bee-x {
    0% {
      translate: 0 0;
      scale: var(--face) 1;
    }
    46% {
      scale: var(--face) 1;
    }
    50% {
      translate: var(--range-x) 0;
    }
    54% {
      scale: calc(var(--face) * -1) 1;
    }
    96% {
      scale: calc(var(--face) * -1) 1;
    }
    100% {
      translate: 0 0;
      scale: var(--face) 1;
    }
  }
  @keyframes bee-y {
    from {
      translate: 0 0;
    }
    to {
      translate: 0 var(--range-y);
    }
  }
  .bee {
    display: block;
    width: 2.3rem;
    height: auto;
    overflow: visible;
    filter: drop-shadow(0 4px 4px rgb(32 51 28 / 0.25));
    animation: bee-hover 0.35s ease-in-out infinite alternate;
  }
  .bee-fly--2 .bee {
    width: 2rem;
  }
  .bee-fly--3 .bee {
    width: 1.7rem;
  }
  @keyframes bee-hover {
    to {
      translate: 0 2px;
    }
  }
  .bee__body {
    fill: #f6c13a;
  }
  .bee__stripes,
  .bee__head,
  .bee__sting {
    fill: #2c2214;
  }
  .bee__outline {
    fill: none;
    stroke: #2c2214;
    stroke-width: 1;
  }
  .bee__eye {
    fill: #fff;
  }
  .bee__antenna {
    fill: none;
    stroke: #2c2214;
    stroke-width: 1;
    stroke-linecap: round;
  }
  .bee__wing {
    fill: rgb(255 255 255 / 0.78);
    stroke: #9ab3c4;
    stroke-width: 0.6;
    transform-box: view-box;
    transform-origin: 0 -3px;
    animation: buzz 0.07s linear infinite alternate;
  }
  .bee__wing--back {
    fill: rgb(235 244 250 / 0.7);
    animation-delay: -0.035s;
  }
  @keyframes buzz {
    to {
      transform: rotate(-30deg) scaleY(0.7);
    }
  }

  /* ---------- page-header variant: photo only on the right, softer ---------- */
  .field--calm {
    left: auto;
    width: min(70%, 62rem);
    -webkit-mask-image: linear-gradient(90deg, transparent 0, rgb(0 0 0 / 0.6) 28%, #000 60%);
    mask-image: linear-gradient(90deg, transparent 0, rgb(0 0 0 / 0.6) 28%, #000 60%);
  }
  .field--calm .field__zoom {
    animation-duration: 50s;
  }
  .field--calm .field__zoom :global(.field__photo) {
    object-position: 50% 42%;
  }
  .field--calm .cloud {
    filter: blur(8px);
  }
  @media (max-width: 700px) {
    .field--calm {
      width: 100%;
      opacity: 0.45;
    }
  }
</style>
