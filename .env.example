# Where contact, membership and event-registration forms are POSTed (JSON).
# Works with Formspree, Web3Forms, Getform, Basin ... or your own endpoint.
# Leave empty to fall back to opening the visitor's e-mail app (mailto:).
PUBLIC_FORM_ENDPOINT=

# Where the e-novice (newsletter) sign-up is POSTed. Leave empty for the mailto: fallback.
PUBLIC_NEWSLETTER_ENDPOINT=

# Optional: embed URL of a Google "My Maps" map with all member farms (shown on /kmetije/zemljevid/).
PUBLIC_FARMS_MAP_EMBED=
